# --- Evaluation outputs that hold raw conversation text (synthetic, but never published) ---
# Local-only working files: benchmark transcripts, review sheets and run logs.
.local/
# Temporary context transfer for local AI-assisted work; not project documentation.
docs/PROJECT_CONTEXT_PROMPT.md
# If a run is pointed anywhere else, these names are the raw outputs the evaluation tools write.
# (`docs/benchmark/`, `backend/benchmark-runs/` and `benchmark-runs/` are deliberately NOT
# ignored: a test requires the tools to refuse them as output directories.)
smoke-raw.json
acceptance-raw.json
raw-?.json
partial-raw.jsonl
partial-scores.jsonl
review-sheet.md
review-key.json
review-judgments*.json

# --- Local audio recordings used during development ----------------------------------------
# Only these directories: audio test fixtures elsewhere stay trackable.
recordings/
local-audio/
