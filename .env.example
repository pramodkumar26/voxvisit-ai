APP_NAME=VoxVisit AI Backend
APP_VERSION=0.1.0
APP_ENV=development
LOG_LEVEL=INFO

POSTGRES_DB=voxvisit
POSTGRES_USER=voxvisit
POSTGRES_PASSWORD=local-development-only-change-me
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://voxvisit:local-development-only-change-me@127.0.0.1:5432/voxvisit
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=5
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Local development-only demonstration credentials used by the data seeder.
# Choose your own: the PIN must be exactly six digits; the password at least 12 characters.
SEED_PATIENT_PIN=
SEED_STAFF_PASSWORD=

# Authentication. All are optional for local development.
# AUTH_SECRET_KEY keys CSRF tokens and network fingerprints (32+ characters). Without it a
# temporary key is generated at startup, so CSRF tokens reset whenever the server restarts.
# Required in production. Example: python -c "import secrets; print(secrets.token_urlsafe(48))"
# AUTH_SECRET_KEY=
# Comma-separated exact origins allowed to call the API with credentials (no wildcards).
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# AUTH_COOKIE_SECURE=false
# AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_DOMAIN=
# AUTH_TRUST_FORWARDED_FOR=false
